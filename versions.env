# Image tags for every service. Bump here, then rerun ./install.sh --only <component>.
# Tags were chosen from memory in Oct 2026: check each against its registry before a production run.
TRAEFIK_IMAGE=traefik:v3.3
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2
VAULT_IMAGE=hashicorp/vault:1.18
GITEA_IMAGE=gitea/gitea:1.23
JENKINS_IMAGE=jenkins/jenkins:lts-jdk21
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
SONARQUBE_IMAGE=sonarqube:community
NEXUS_IMAGE=sonatype/nexus3:3.79.1
DEFECTDOJO_DJANGO_IMAGE=defectdojo/defectdojo-django:2.45.0
DEFECTDOJO_NGINX_IMAGE=defectdojo/defectdojo-nginx:2.45.0
DTRACK_API_IMAGE=dependencytrack/apiserver:4.13.0
DTRACK_FRONTEND_IMAGE=dependencytrack/frontend:4.13.0
PROMETHEUS_IMAGE=prom/prometheus:v3.3.0
GRAFANA_IMAGE=grafana/grafana:11.6.0
LOKI_IMAGE=grafana/loki:3.4.2
PROMTAIL_IMAGE=grafana/promtail:3.4.2
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.0
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
# Scanner images (used by the CLI wrappers and by Jenkins agents)
TRIVY_IMAGE=aquasec/trivy:0.61.0
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.24.2
SEMGREP_IMAGE=semgrep/semgrep:1.116.0
SYFT_IMAGE=anchore/syft:v1.23.1
HADOLINT_IMAGE=hadolint/hadolint:v2.12.0
CHECKOV_IMAGE=bridgecrew/checkov:3.2.413
KICS_IMAGE=checkmarx/kics:v2.1.7
ZAP_IMAGE=zaproxy/zap-stable:2.16.1
