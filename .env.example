# scripts/00-prereqs.sh copies this to .env on the first run, takes any of these keys from the
# environment (sudo HOST_ADDRESS=10.0.0.20 ./install.sh) and fills every empty *_PASSWORD / *_SECRET
# with a random value. Never commit .env.

# How clients reach this host: its name on the client's network or its IP. No DNS zone is
# needed; every tool is served on this address at its own port (see the port list below).
# Empty: the first IP of the host, as reported by `hostname -I`.
HOST_ADDRESS=

# Where persistent data lives on the host.
DATA_ROOT=/srv/devsecops

# Docker network shared by all stacks.
DOCKER_NETWORK=devsecops

# Timezone for every container.
TZ=Africa/Tunis

# Contact address recorded on the first admin accounts (Gitea, DefectDojo, Jenkins).
ADMIN_EMAIL=devsecops@localhost

# Host port for Gitea SSH (22 is usually taken by the host's sshd).
GITEA_SSH_PORT=2222

# Secrets. Empty values are generated by scripts/00-prereqs.sh.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
GITEA_ADMIN_PASSWORD=
GITEA_DB_PASSWORD=
SONAR_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
DEFECTDOJO_ADMIN_PASSWORD=
DEFECTDOJO_DB_PASSWORD=
DEFECTDOJO_SECRET_KEY=
DEFECTDOJO_CREDENTIAL_AES_KEY=
DTRACK_DB_PASSWORD=
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=

# Build capacity: Jenkins agents allowed to run at the same time. Sizing in docs/sizing.md.
JENKINS_MAX_AGENTS=5

# Ingress. traefik (default): Traefik terminates TLS on one port and serves every tool under
# its own path, https://HOST_ADDRESS/gitea, /jenkins, /sonarqube, /nexus, /keycloak, /grafana,
# /prometheus, with a self-signed certificate for HOST_ADDRESS (or the client's own certificate
# dropped in ${DATA_ROOT}/traefik/certs/, see docs/tools/traefik.md). Port 80 redirects to it.
# Tools that cannot run under a sub-path keep a TLS port of their own: the Docker registry,
# Vault, DefectDojo and Dependency-Track.
# ports: no reverse proxy, each tool publishes its port itself over plain HTTP. Used by the
# strict minimum profile (docs/strict-minimum.md) and when the client terminates TLS on an
# existing proxy. Only gitea, jenkins, sonarqube and nexus support ports mode.
INGRESS=traefik

# Traefik mode: the HTTPS port every sub-path tool shares, and the HTTP port that redirects to it.
TRAEFIK_HTTPS_PORT=443
TRAEFIK_HTTP_PORT=80

# Ports mode: one host port per tool.
GITEA_HTTP_PORT=3000
JENKINS_HTTP_PORT=8080
SONARQUBE_HTTP_PORT=9000
NEXUS_HTTP_PORT=8081

# Both modes: tools that need a port of their own (TLS behind Traefik, plain HTTP in ports mode).
REGISTRY_PORT=5000
VAULT_HTTP_PORT=8200
DEFECTDOJO_HTTP_PORT=8083
DTRACK_HTTP_PORT=8090
DTRACK_API_PORT=8091

# Per-branch test environments deployed by Jenkins (tb-pipelines, deploy.mode perBranch with
# deploy.ingress): slot N is served at https://HOST_ADDRESS:<TEST_ENV_PORT_BASE + N>, one TLS
# entry point per slot. Containers join TEST_ENV_NETWORK, never the platform network. Projects
# share the slots through deploy.ingress.slotOffset: amadeus-ws 1 to 5, amadeus_ws_backoffice 6 to 10.
TEST_ENV_PORT_BASE=8100
TEST_ENV_SLOTS=10
TEST_ENV_NETWORK=test-envs

# Public URLs are derived from HOST_ADDRESS, the mode and the ports. Set them explicitly (no
# trailing slash) when an external proxy fronts the tools, for example
# GITEA_URL=https://git.client.internal. In Traefik mode a URL must keep a sub-path.
#GITEA_URL=
#JENKINS_URL=
#SONARQUBE_URL=
#NEXUS_URL=
#REGISTRY_HOST=
#KEYCLOAK_URL=
#VAULT_URL=
#DEFECTDOJO_URL=
#DTRACK_URL=
#DTRACK_API_URL=
#GRAFANA_URL=
#PROMETHEUS_URL=
