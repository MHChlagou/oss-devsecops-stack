# Copy to .env (scripts/00-prereqs.sh does this and fills every *_PASSWORD / *_SECRET with random values).
# Never commit .env.

# Base DNS domain. Every service gets <name>.${DOMAIN}; point a wildcard record at this host.
DOMAIN=devsecops.example.internal

# Where persistent data lives on the host.
DATA_ROOT=/srv/devsecops

# Docker network shared by all stacks.
DOCKER_NETWORK=devsecops

# TLS. Leave CERT_RESOLVER empty on a private network: Traefik serves its own self-signed
# certificate. Set CERT_RESOLVER=le and ACME_EMAIL when the host has public DNS and port 80 open.
CERT_RESOLVER=
ACME_EMAIL=

# Timezone for every container.
TZ=Africa/Tunis

# Host port for Gitea SSH (22 is usually taken by the host's sshd).
GITEA_SSH_PORT=2222

# Secrets. Empty values are generated by scripts/00-prereqs.sh.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
GITEA_ADMIN_PASSWORD=
GITEA_DB_PASSWORD=
SONAR_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
DEFECTDOJO_ADMIN_PASSWORD=
DEFECTDOJO_DB_PASSWORD=
DEFECTDOJO_SECRET_KEY=
DEFECTDOJO_CREDENTIAL_AES_KEY=
DTRACK_DB_PASSWORD=
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=

# Build capacity: Jenkins agents allowed to run at the same time. Sizing in docs/sizing.md.
JENKINS_MAX_AGENTS=5

# Ingress. traefik (default): one TLS entry point, tools at https://<name>.${DOMAIN}.
# ports: no reverse proxy, each tool published on a host port over plain HTTP. Used by the
# strict minimum profile (docs/strict-minimum.md) and when the client terminates TLS on an
# existing proxy. Only gitea, jenkins, sonarqube and nexus support ports mode.
INGRESS=traefik
# Address clients use to reach this host in ports mode (IP or DNS name). Defaults to the first host IP.
HOST_ADDRESS=
GITEA_HTTP_PORT=3000
JENKINS_HTTP_PORT=8080
SONARQUBE_HTTP_PORT=9000
NEXUS_HTTP_PORT=8081
REGISTRY_PORT=5000
# Public URLs are derived from INGRESS. Set them explicitly (no trailing slash) when an external
# proxy fronts the tools, for example GITEA_URL=https://git.client.internal
#GITEA_URL=
#JENKINS_URL=
#SONARQUBE_URL=
#NEXUS_URL=
#REGISTRY_HOST=
